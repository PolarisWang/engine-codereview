#!/usr/bin/env groovy
/*
 * Code Review Pipeline
 *
 * Two modes:
 *   1. Scan mode (cron triggered, no JIRA_URL) — poll Feishu group for new
 *      topic messages containing Jira URLs, reply in-thread with review results
 *   2. Direct mode (JIRA_URL provided) — review a specific Jira issue
 *
 * Triggered by:
 *   - cron: every 30 seconds (scan mode)
 *   - manual: with JIRA_URL parameter
 *
 * Requires Jenkins global env vars:
 *   JIRA_HOST, JIRA_TOKEN — Jira API access
 *   GITLAB_TOKEN — GitLab API for MR branch detection
 *   FEISHU_APP_ID, FEISHU_APP_SECRET — Feishu bot credentials
 */

// Pipeline-global base64 encoder (bypasses Jenkins sandbox blocking Groovy extensions)
def b64(s) {
    return java.util.Base64.getEncoder().encodeToString(s.toString().getBytes("UTF-8"))
}

// Structured build-log line, greppable via: grep '[CODEREVIEW]'
def codereviewLog(phase, status, topic='', issue='', project='', repo='', detail='') {
    def parts = [phase ?: '', status ?: '']
    echo "[CODEREVIEW] phase=${parts[0]} status=${parts[1]}" + (topic ? " topic=${topic}" : "") + (issue ? " issue=${issue}" : "") + (project ? " project=${project}" : "") + (repo ? " repo=${repo}" : "") + (detail ? " detail=${detail}" : "")
}

// Invoke pipeline_state.py as a CLI subcommand (fire-and-forget state updates).
def psCmd(extraArgs) {
    sh "${PYTHON} ${SCRIPTS_DIR}/pipeline_state.py ${extraArgs} --state-file '${PIPELINE_STATE_FILE}'"
}

// Shell-quote a string for safe embedding in psCmd's sh (escapes single quotes
// and newlines). Prevents free-text (error/skip_reason/stats/paths) from breaking
// or injecting into the shell command line.
def shq(s) {
    return "'" + (s.toString().replaceAll("'", "\\\\'").replaceAll("\\r?\\n", " ")) + "'"
}

// Record one repo's terminal state into pipeline state from its result file.
// SUCCESS (with optional partial error), SKIPPED or FAILED are derived from the
// code_reviewer output contract. Used by manual mode's stage post-blocks (scan
// mode records repo states from orchestrate.py instead).
def recordRepoState(msgId, repo, resultFile, result, reviewBranch, baseBranch) {
    def resultNull = (result == null || result instanceof net.sf.json.JSONNull || result == [:])
    if (resultNull) {
        psCmd("repo --key ${shq(msgId)} --repo ${repo} --status FAILED --error ${shq('no result file')}")
        codereviewLog('REPO', 'FAILED', msgId, '', '', repo, 'no result file')
        return
    }
    def review = result.review ?: [:]
    def err = review.error ?: result.error ?: ''
    def branchMerged = result.branch_merged ?: false
    def branchExists = result.containsKey('branch_exists') ? result.branch_exists : true
    def sev = review.severity_counts ?: [:]
    def sevJson = "{\"critical\":${sev.critical ?: 0},\"warning\":${sev.warning ?: 0},\"suggestion\":${sev.suggestion ?: 0}}"
    def changed = (result.changed_files ?: []).size()
    def stats = result.stats ?: ''

    if (!branchExists) {
        psCmd("repo --key ${shq(msgId)} --repo ${repo} --status SKIPPED --skip-reason ${shq('branch ' + reviewBranch + ' not remote')} --result-file ${shq(resultFile)}")
        codereviewLog('REPO', 'SKIPPED', msgId, '', '', repo, 'branch not remote')
    } else if (branchMerged) {
        psCmd("repo --key ${shq(msgId)} --repo ${repo} --status SKIPPED --skip-reason ${shq('already merged')} --result-file ${shq(resultFile)}")
        codereviewLog('REPO', 'SKIPPED', msgId, '', '', repo, 'already merged')
    } else if (changed == 0 && !err) {
        psCmd("repo --key ${shq(msgId)} --repo ${repo} --status SKIPPED --skip-reason ${shq('no changes vs ' + baseBranch)} --result-file ${shq(resultFile)}")
        codereviewLog('REPO', 'SKIPPED', msgId, '', '', repo, 'no diff changes')
    } else {
        // SUCCESS (partial-error is carried in the error field, matching render).
        psCmd("repo --key ${shq(msgId)} --repo ${repo} --status SUCCESS --error ${shq(err)} --result-file ${shq(resultFile)} --severity-json ${shq(sevJson)} --stats ${shq(stats)} --changed-files ${shq(changed)}")
        if (err) {
            codereviewLog('REPO', 'PARTIAL', msgId, '', '', repo, err)
        } else {
            codereviewLog('REPO', 'SUCCESS', msgId, '', '', repo, "${changed} files, ${stats}")
        }
    }
}

pipeline {
    agent { label 'code-review' }

    options {
        // Prevents two scans from racing (duplicate reviews) and manual runs from
        // overlapping a scan. KNOWN TRADE-OFF: a long manual (JIRA_URL) build holds
        // this lock, so every-minute cron scans queue behind it (starvation/latency).
        // Preferred fix (see docs/jenkins-credentials.md / ops notes): split into
        // separate `codereview-scan` (cron) and `codereview-manual` (manual) jobs so
        // a long manual review cannot block message scanning.
        disableConcurrentBuilds()
    }

    triggers {
        cron('* * * * *')
    }

    parameters {
        string(name: 'JIRA_URL', defaultValue: '',
               description: 'Jira issue URL (leave empty for auto-scan mode)')
        string(name: 'FEISHU_REPLY_MSG_ID', defaultValue: '',
               description: 'Feishu message ID to reply in (leave empty for new topic)')
    }

    environment {
        PYTHON = sh(script: "which python3 2>/dev/null || which python 2>/dev/null || echo '/usr/bin/python3'", returnStdout: true).trim()
        SCRIPTS_DIR = "${env.WORKSPACE}/jenkins/scripts"
        CONFIG_FILE = "${env.WORKSPACE}/config.yaml"
        REVIEW_WORKSPACE = "${env.HOME}/codereview-workspace"
        SCAN_RESULT_FILE = "${env.WORKSPACE}/scan_result.json"
        PARSED_INFO_FILE = "${env.WORKSPACE}/parsed_info.json"
        ENGINE_RESULT_FILE = "${env.WORKSPACE}/engine_result.json"
        GAME_RESULT_FILE = "${env.WORKSPACE}/game_result.json"
        REVIEWED_STATE_FILE = "${env.WORKSPACE}/.codereview-feishu-state.json"   // Feishu scanner state (processed msg IDs)
        REVIEWED_MSG_IDS_FILE = "${env.HOME}/.codereview-processed-msg-ids.json" // Cross-build dedup of processed message IDs
        // Topic-level pipeline state record (survives builds; NOT touched by cleanup).
        PIPELINE_STATE_FILE = "${env.HOME}/.codereview-pipeline-state.json"

        // GitLab token for HTTPS clone + MR branch detection
        GITLAB_TOKEN = "${env.GITLAB_TOKEN ?: ''}"
        GITLAB_USER = "gitlab-ci-token"

        // Feishu Bot API (for topic messages)
        // NOTE: inject FEISHU_APP_ID / FEISHU_APP_SECRET / FEISHU_CHAT_ID via
        // Jenkins credentials (see docs/jenkins-credentials.md). The CHAT_ID
        // fallback below is a documented hardcoded default.
        FEISHU_APP_ID = "${env.FEISHU_APP_ID ?: ''}"
        FEISHU_APP_SECRET = "${env.FEISHU_APP_SECRET ?: ''}"
        FEISHU_CHAT_ID = "${env.FEISHU_CHAT_ID ?: 'oc_254e95f0687245b9df82ab8bf823ca54'}"
        // Fallback webhook — a live incoming-webhook URL is hardcoded here for
        // resilience when the Bot API is unavailable (see docs/jenkins-credentials.md).
        // Prefer injecting FEISHU_WEBHOOK_URL_OVERRIDE via Jenkins credentials.
        FEISHU_WEBHOOK_URL = "${env.FEISHU_WEBHOOK_URL_OVERRIDE ?: 'https://open.feishu.cn/open-apis/bot/v2/hook/f2ec1781-06d2-42c8-91b4-37616d973970'}"

        // Jira credentials (injected via Jenkins global env or credentials)
        JIRA_HOST = "${env.JIRA_HOST ?: ''}"
        JIRA_TOKEN = "${env.JIRA_TOKEN ?: ''}"
    }

    stages {
        // ──────────────────────────────────────────────
        // Stage 0: Scan Feishu — only when JIRA_URL is empty
        // ──────────────────────────────────────────────
        stage('Scan Feishu Messages') {
            when { expression { params.JIRA_URL == null || params.JIRA_URL == '' } }
            steps {
                script {
                    sh """
                        ${PYTHON} ${SCRIPTS_DIR}/feishu_scanner.py \
                            --app-id '${env.FEISHU_APP_ID}' \
                            --app-secret '${env.FEISHU_APP_SECRET}' \
                            --chat-id '${env.FEISHU_CHAT_ID}' \
                            --jira-host '${env.JIRA_HOST}' \
                            --state-file '${REVIEWED_STATE_FILE}' \
                            --output '${SCAN_RESULT_FILE}'
                    """
                    scanResult = readJSON(file: SCAN_RESULT_FILE)
                    items = scanResult.items ?: []

                    // Filter out already-processed message IDs.
                    // Dual-source dedup (migration window): legacy processed_ids ∪
                    // topics already in a terminal phase in the pipeline-state file.
                    // Whichever mechanism records first wins; both converge.
                    def processedIds = []
                    if (fileExists(REVIEWED_MSG_IDS_FILE)) {
                        def reviewedData = readJSON(file: REVIEWED_MSG_IDS_FILE)
                        processedIds = reviewedData.processed_ids ?: []
                    }
                    def terminalKeys = []
                    if (fileExists(PIPELINE_STATE_FILE)) {
                        def termJson = sh(script: "${PYTHON} ${SCRIPTS_DIR}/pipeline_state.py query --json --state-file '${PIPELINE_STATE_FILE}'", returnStdout: true).trim()
                        if (termJson) {
                            def topics = readJSON(text: termJson)
                            if (topics instanceof List) {
                                // DONE and SKIPPED are terminal (no auto-retry). FAILED is
                                // retryable and handled by the backoff filter below.
                                terminalKeys = topics.findAll { t ->
                                    t.phase == 'DONE' || t.status == 'SKIPPED'
                                }.collect { t -> t.message_id }
                            }
                        }
                    }
                    def doneIds = (processedIds + terminalKeys) as Set
                    echo "Filtering ${doneIds.size()} already-processed message IDs (processed=${processedIds.size()} terminal=${terminalKeys.size()})"
                    items = items.findAll { item -> !(item.message_id in doneIds) }

                    // Retry backoff: a FAILED topic is reprocessed only once its
                    // exponential-backoff window has elapsed and it isn't exhausted.
                    // (DONE/SKIPPED/processed were already filtered above; UNKNOWN → allow.)
                    def topicStates = [:]
                    if (fileExists(PIPELINE_STATE_FILE)) {
                        def allJson = sh(script: "${PYTHON} ${SCRIPTS_DIR}/pipeline_state.py query --json --state-file '${PIPELINE_STATE_FILE}'", returnStdout: true).trim()
                        if (allJson) {
                            def allTopics = readJSON(text: allJson)
                            if (allTopics instanceof List) {
                                for (t in allTopics) { topicStates[t.message_id] = t }
                            }
                        }
                    }
                    def nowEpoch = (long)(System.currentTimeMillis() / 1000)
                    def retryableFilter = { item ->
                        def st = topicStates[item.message_id]
                        if (st == null) return true
                        if (st.failed_exhausted == true) return false
                        if (st.phase != 'FAILED') return true
                        def nxt = (st.next_retry_at ?: '') as String
                        if (nxt == '') return true   // no schedule → allow immediate retry
                        // Parse ISO next_retry_at (local) into epoch.
                        try {
                            def fmt = new java.text.SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss")
                            def nxtEpoch = fmt.parse(nxt).getTime() / 1000
                            return nowEpoch >= (long)nxtEpoch
                        } catch (Exception e) {
                            return true
                        }
                    }
                    items = items.findAll(retryableFilter)

                    // Build the list of topics to process this tick:
                    //   (a) fresh scan items (most recent message), plus
                    //   (b) FAILED topics eligible for automatic retry (driven from
                    //       pipeline state, NOT the scan window — so a message that
                    //       aged out of the scanner cursor can still be retried).
                    def retryables = []
                    if (fileExists(PIPELINE_STATE_FILE)) {
                        def retryJson = sh(script: "${PYTHON} ${SCRIPTS_DIR}/pipeline_state.py retryable --state-file '${PIPELINE_STATE_FILE}'", returnStdout: true).trim()
                        if (retryJson) {
                            def parsed = readJSON(text: retryJson)
                            if (parsed instanceof List) {
                                retryables = parsed
                            }
                        }
                    }
                    echo "Scan: ${items.size()} new message(s), ${retryables.size()} retryable FAILED topic(s)"

                    // Prefer processing fresh messages; then drain retryables. Bound total
                    // so we never process more than a handful per build (retry backoff
                    // already limits how many are 'retryable' right now).
                    def nFresh = Math.min(items.size(), 1)          // one fresh message per build
                    def nRetry = Math.min(retryables.size(), 3)     // up to 3 retries per build
                    if (nFresh + nRetry == 0) {
                        currentBuild.result = 'SUCCESS'
                    }
                    int processedCount = 0
                    for (int k = 0; k < nFresh && processedCount < 4; k++) {
                        def item = items[k]
                        def issueKey = item.issue_key
                        def jiraUrl = item.jira_url
                        def msgId = item.message_id
                        psCmd("add --key ${shq(msgId)} --jira-key ${shq(issueKey)} --jira-url ${shq(jiraUrl)} --mode scan --text ${shq(item.text ?: '')} --sender-id ${shq(item.sender_id ?: '')} --sender-name ${shq(item.sender_name ?: '')}")
                        codereviewLog('SCANNED', 'RUNNING', msgId, issueKey, '', '', 'topic discovered')
                        def rc = sh script: """
                            ${PYTHON} ${SCRIPTS_DIR}/orchestrate.py run \
                                --key ${shq(msgId)} \
                                --mode scan \
                                --workspace '${REVIEW_WORKSPACE}' \
                                --pipeline-state-file '${PIPELINE_STATE_FILE}' \
                                --jira-key ${shq(issueKey)} \
                                --jira-url ${shq(jiraUrl)} \
                                --text ${shq(item.text ?: '')} \
                                --sender-id ${shq(item.sender_id ?: '')} \
                                --sender-name ${shq(item.sender_name ?: '')}
                        """, returnStatus: true
                        if (rc != 0) {
                            echo "orchestrate.py run failed for ${msgId} (rc ${rc})"
                        }
                        processedCount++
                    }
                    for (int k = 0; k < nRetry && processedCount < 4; k++) {
                        def r = retryables[k]
                        def msgId = r.message_id
                        def jiraUrl = r.jira_url
                        def jiraKey = r.jira_key ?: jiraUrl
                        codereviewLog('SCANNED', 'RETRY', msgId, jiraKey, '', '', "retry automated (count ${r.retry_count ?: 0})")
                        def rc = sh script: """
                            ${PYTHON} ${SCRIPTS_DIR}/orchestrate.py run \
                                --key ${shq(msgId)} \
                                --mode scan \
                                --workspace '${REVIEW_WORKSPACE}' \
                                --pipeline-state-file '${PIPELINE_STATE_FILE}' \
                                --jira-key ${shq(jiraKey)} \
                                --jira-url ${shq(jiraUrl)}
                        """, returnStatus: true
                        if (rc != 0) {
                            echo "orchestrate.py retry failed for ${msgId} (rc ${rc})"
                        }
                        processedCount++
                    }
                }
            }
        }

        // ──────────────────────────────────────────────
        // Stage 1: Parse Jira URL → project + MR info
        // ──────────────────────────────────────────────
        stage('Parse Jira Issue') {
            when {
                expression { params.JIRA_URL != null && params.JIRA_URL != '' }
            }
            steps {
                script {
                    // Manual mode topic record. Use the Jira URL as the key (no
                    // message_id is known yet); issue key resolved after parse.
                    def manTopic = params.JIRA_URL ?: 'manual-topic'
                    psCmd("add --key ${shq(manTopic)} --jira-url ${shq(params.JIRA_URL)} --mode manual")
                    codereviewLog('MANUAL', 'RUNNING', manTopic, '', '', '', 'manual review started')

                    sh """
                        ${PYTHON} ${SCRIPTS_DIR}/jira_parser.py \
                            --jira-url '${params.JIRA_URL}' \
                            --jira-host '${env.JIRA_HOST}' \
                            --jira-token '${env.JIRA_TOKEN}' \
                            --gitlab-token '${env.GITLAB_TOKEN}' \
                            > ${PARSED_INFO_FILE}
                    """
                    parsedInfo = readJSON(file: PARSED_INFO_FILE)

                    if (parsedInfo.containsKey('error')) {
                        error("Jira parse failed: ${parsedInfo.error}")
                    }

                    env.ISSUE_KEY   = parsedInfo.issue_key
                    env.PROJECT     = parsedInfo.project
                    env.ENGINE_REPO = parsedInfo.engine_repo
                    env.GAME_REPO   = parsedInfo.game_repo
                    env.BASE_BRANCH = parsedInfo.default_branch
                    env.ENGINE_BASE_BRANCH = parsedInfo.containsKey('engine_default_branch') ? parsedInfo.engine_default_branch : parsedInfo.default_branch
                    env.MR_URL      = parsedInfo.mr_url ?: ''

                    if (parsedInfo.mr_info != null && parsedInfo.mr_info.toString() != 'null') {
                        env.REVIEW_BRANCH = parsedInfo.mr_info.branch ?: parsedInfo.issue_key
                        // Use MR target_branch as base if available
                        if (parsedInfo.mr_info.target_branch) {
                            env.BASE_BRANCH = parsedInfo.mr_info.target_branch
                            env.ENGINE_BASE_BRANCH = parsedInfo.mr_info.target_branch
                        }
                    } else {
                        env.REVIEW_BRANCH = parsedInfo.issue_key
                    }

                    // Game MR info if provided
                    env.GAME_MR_URL = parsedInfo.containsKey('game_mr_url') ? (parsedInfo.game_mr_url ?: '') : ''
                    if (parsedInfo.containsKey('game_mr_info') && parsedInfo.game_mr_info != null && parsedInfo.game_mr_info.toString() != 'null') {
                        env.GAME_MR_BRANCH = parsedInfo.game_mr_info.branch ?: ''
                        env.GAME_BASE_BRANCH = parsedInfo.game_mr_info.target_branch ?: env.BASE_BRANCH
                    } else {
                        env.GAME_MR_BRANCH = ''
                        env.GAME_BASE_BRANCH = env.BASE_BRANCH
                    }

                    echo "Parsed: ${env.ISSUE_KEY} → ${env.PROJECT}"
                    echo "Engine: ${env.ENGINE_REPO}"
                    echo "Game:   ${env.GAME_REPO}"
                    echo "Branch: ${env.REVIEW_BRANCH} → ${env.BASE_BRANCH}"
                    echo "Engine base: ${env.ENGINE_BASE_BRANCH}"
                    echo "Game base: ${env.GAME_BASE_BRANCH}"

                    // Persist FEISHU_REPLY_MSG_ID to file for post block access
                    writeFile(file: "${env.WORKSPACE}/.feishu_reply_msg_id", text: "${params.FEISHU_REPLY_MSG_ID ?: ''}", encoding: "UTF-8")

                    // Manual topic: record PARSED + resolved branch/base/project.
                    // (manTopic is already declared at the top of this script block.)
                    psCmd("transition --key ${shq(manTopic)} --to PARSING --status RUNNING --review-branch ${shq(env.REVIEW_BRANCH)} --base-branch ${shq(env.BASE_BRANCH)} --mr-url ${shq(env.MR_URL)}")
                    codereviewLog('PARSED', 'RUNNING', manTopic, env.ISSUE_KEY, env.PROJECT, '', "branch=${env.REVIEW_BRANCH}->${env.BASE_BRANCH}")
                }
            }
        }

        // ──────────────────────────────────────────────
        // Stage 2: Parallel Code Review (Engine + Game)
        // ──────────────────────────────────────────────
        stage('Code Review') {
            when { expression { env.ISSUE_KEY != null && env.ISSUE_KEY != '' } }
            // Manual mode: engine + game reviewed in a true parallel. Per-repo state
            // is recorded by the stages' post blocks (recordRepoState).
            parallel {
                stage('Engine Repo') {
                    steps {
                        script {
                            def engineBranch = env.REVIEW_BRANCH
                            def engineBase = env.ENGINE_BASE_BRANCH
                            def engineMrUrl = env.MR_URL
                            sh """
                                ${PYTHON} ${SCRIPTS_DIR}/code_reviewer.py \
                                    --repo '${env.ENGINE_REPO}' \
                                    --branch '${engineBranch}' \
                                    --base-branch '${engineBase}' \
                                    --project '${env.PROJECT}' \
                                    --issue-key '${env.ISSUE_KEY}' \
                                    --repo-type 'engine' \
                                    --mr-url '${engineMrUrl}' \
                                    --workspace '${REVIEW_WORKSPACE}' \
                                    --output '${ENGINE_RESULT_FILE}'
                            """
                        }
                    }
                    post {
                        success {
                            script {
                                def manTopic = params.JIRA_URL ?: 'manual-topic'
                                def engRes = fileExists(ENGINE_RESULT_FILE) ? readJSON(file: ENGINE_RESULT_FILE) : [:]
                                recordRepoState(manTopic, 'engine', ENGINE_RESULT_FILE, engRes, env.REVIEW_BRANCH, env.ENGINE_BASE_BRANCH)
                            }
                        }
                        failure {
                            script {
                                writeJSON(file: ENGINE_RESULT_FILE, json: [
                                    project: env.PROJECT, issue_key: env.ISSUE_KEY,
                                    repo_type: 'engine', error: 'Review failed'
                                ])
                                def manTopic = params.JIRA_URL ?: 'manual-topic'
                                psCmd("repo --key '${manTopic}' --repo engine --status FAILED --error 'review stage failed'")
                                codereviewLog('REPO', 'FAILED', manTopic, env.ISSUE_KEY, env.PROJECT, 'engine', 'review stage failure')
                            }
                        }
                    }
                }

                stage('Game Repo') {
                    steps {
                        script {
                            def gameBranch = env.GAME_MR_BRANCH ?: env.REVIEW_BRANCH
                            def gameBase = env.GAME_BASE_BRANCH ?: env.BASE_BRANCH
                            def gameMrUrl = env.GAME_MR_URL ?: env.MR_URL
                            sh """
                                ${PYTHON} ${SCRIPTS_DIR}/code_reviewer.py \
                                    --repo '${env.GAME_REPO}' \
                                    --branch '${gameBranch}' \
                                    --base-branch '${gameBase}' \
                                    --project '${env.PROJECT}' \
                                    --issue-key '${env.ISSUE_KEY}' \
                                    --repo-type 'game' \
                                    --mr-url '${gameMrUrl}' \
                                    --workspace '${REVIEW_WORKSPACE}' \
                                    --output '${GAME_RESULT_FILE}'
                            """
                        }
                    }
                    post {
                        success {
                            script {
                                def manTopic = params.JIRA_URL ?: 'manual-topic'
                                def gamRes = fileExists(GAME_RESULT_FILE) ? readJSON(file: GAME_RESULT_FILE) : [:]
                                recordRepoState(manTopic, 'game', GAME_RESULT_FILE, gamRes, env.GAME_MR_BRANCH ?: env.REVIEW_BRANCH, env.GAME_BASE_BRANCH)
                            }
                        }
                        failure {
                            script {
                                writeJSON(file: GAME_RESULT_FILE, json: [
                                    project: env.PROJECT, issue_key: env.ISSUE_KEY,
                                    repo_type: 'game', error: 'Review failed'
                                ])
                                def manTopic = params.JIRA_URL ?: 'manual-topic'
                                psCmd("repo --key '${manTopic}' --repo game --status FAILED --error 'review stage failed'")
                                codereviewLog('REPO', 'FAILED', manTopic, env.ISSUE_KEY, env.PROJECT, 'game', 'review stage failure')
                            }
                        }
                    }
                }
            }
        }
    }

    // ──────────────────────────────────────────────
    // Post: Send results to Feishu + update state
    // ──────────────────────────────────────────────
    post {
        success {
            script {
                if (env.ISSUE_KEY == null || env.ISSUE_KEY == '') {
                    echo "No issues to review — skipping notification"
                    return
                }

                // In scan mode (no explicit JIRA_URL), results were already sent inline
                def isScanMode = (params.JIRA_URL == null || params.JIRA_URL == '')
                if (isScanMode) {
                    echo "Scan mode — results already sent inline, skipping post notification"
                    return
                }

                def engineResult = fileExists(ENGINE_RESULT_FILE) ? readJSON(file: ENGINE_RESULT_FILE) : [:]
                def gameResult   = fileExists(GAME_RESULT_FILE)   ? readJSON(file: GAME_RESULT_FILE)   : [:]
                def feishuWebhook = env.FEISHU_WEBHOOK_URL ?: ''

                // Render the summary via feishu_notifier.render-summary (single source of truth).
                // This replaces the former inline `buildRepoBlock`/topicParts duplication.
                def mrStateForPost = readJSON(file: PARSED_INFO_FILE)?.mr_info?.state ?: ''
                def topicText = sh(
                    script: """
                        ${PYTHON} ${SCRIPTS_DIR}/feishu_notifier.py render-summary \
                            --issue-key '${env.ISSUE_KEY}' \
                            --project '${env.PROJECT}' \
                            --branch '${env.REVIEW_BRANCH}' \
                            --base-branch '${env.BASE_BRANCH}' \
                            --jira-url '${params.JIRA_URL}' \
                            --mr-url '${env.MR_URL}' \
                            --mr-state '${mrStateForPost}' \
                            --engine-file '${ENGINE_RESULT_FILE}' \
                            --game-file '${GAME_RESULT_FILE}'
                    """,
                    returnStdout: true
                ).trim()

                def feishuAppId = env.FEISHU_APP_ID ?: ''
                def feishuAppSecret = env.FEISHU_APP_SECRET ?: ''
                def feishuChatId = env.FEISHU_CHAT_ID ?: ''
                def topicMsgId = fileExists('.feishu_reply_msg_id') ? readFile('.feishu_reply_msg_id', encoding: 'UTF-8').trim() : ''

                if (feishuAppId && feishuAppSecret && feishuChatId) {
                    try {
                        if (topicMsgId) {
                            // ── Reply in existing topic (from FEISHU_REPLY_MSG_ID) ──
                            // 1) Send "Reviewing..." progress reply
                            def progressText = "🤖 **正在 Review...**\n已收到 ${env.ISSUE_KEY}，正在拉取代码并进行 AI 审查，请稍候..."
                            def progressB64 = b64(progressText)
                            sh """
                                ${PYTHON} ${SCRIPTS_DIR}/feishu_notifier.py reply-message \
                                    --app-id '${feishuAppId}' \
                                    --app-secret '${feishuAppSecret}' \
                                    --chat-id '${feishuChatId}' \
                                    --message-id '${topicMsgId}' \
                                    --message-base64 '${progressB64}'
                            """

                            // 2) Reply with summary
                            def summaryB64 = b64(topicText)
                            sh """
                                ${PYTHON} ${SCRIPTS_DIR}/feishu_notifier.py reply-message \
                                    --app-id '${feishuAppId}' \
                                    --app-secret '${feishuAppSecret}' \
                                    --chat-id '${feishuChatId}' \
                                    --message-id '${topicMsgId}' \
                                    --message-base64 '${summaryB64}'
                            """

                            // 3) Reply with engine review details
                            if (engineResult.review?.review_text) {
                                def engineDetail = engineResult.review.review_text
                                def maxLen = 3000
                                if (engineDetail.length() > maxLen) {
                                    engineDetail = engineDetail.substring(0, maxLen) + "\n\n... (剩余内容请在 Jenkins 构建日志中查看)"
                                }
                                def engineB64 = b64("**🔧 Engine 详细报告:**\n${engineDetail}")
                                sh """
                                    ${PYTHON} ${SCRIPTS_DIR}/feishu_notifier.py reply-message \
                                        --app-id '${feishuAppId}' \
                                        --app-secret '${feishuAppSecret}' \
                                        --chat-id '${feishuChatId}' \
                                        --message-id '${topicMsgId}' \
                                        --message-base64 '${engineB64}'
                                """
                            }

                            // 4) Reply with game review details
                            if (gameResult.review?.review_text) {
                                def gameDetail = gameResult.review.review_text
                                def maxLen = 3000
                                if (gameDetail.length() > maxLen) {
                                    gameDetail = gameDetail.substring(0, maxLen) + "\n\n... (剩余内容请在 Jenkins 构建日志中查看)"
                                }
                                def gameB64 = b64("**🎮 Game 详细报告:**\n${gameDetail}")
                                sh """
                                    ${PYTHON} ${SCRIPTS_DIR}/feishu_notifier.py reply-message \
                                        --app-id '${feishuAppId}' \
                                        --app-secret '${feishuAppSecret}' \
                                        --chat-id '${feishuChatId}' \
                                        --message-id '${topicMsgId}' \
                                        --message-base64 '${gameB64}'
                                """
                            }
                        } else {
                            // ── No reply target in manual mode ──
                            // Convention: the bot only REPLIES in the topic group, never
                            // starts a new topic. Refuse instead of send-message (which
                            // would create a new topic).
                            echo "Convention: bot only replies in the group; cannot send a new topic for ${env.ISSUE_KEY} (no FEISHU_REPLY_MSG_ID)"
                            topicMsgId = ''

                            if (engineResult.review?.review_text && topicMsgId) {
                                def engineDetail = "**🔧 Engine 详细报告:**\n${engineResult.review.review_text}"
                                def maxLen = 3000
                                if (engineDetail.length() > maxLen) {
                                    engineDetail = engineDetail.substring(0, maxLen) + "\n\n... (剩余内容请在 Jenkins 构建日志中查看)"
                                }
                                def engineB64 = b64(engineDetail)
                                sh """
                                    ${PYTHON} ${SCRIPTS_DIR}/feishu_notifier.py reply-message \
                                        --app-id '${feishuAppId}' \
                                        --app-secret '${feishuAppSecret}' \
                                        --chat-id '${feishuChatId}' \
                                        --message-id '${topicMsgId}' \
                                        --message-base64 '${engineB64}'
                                """
                            }

                            if (gameResult.review?.review_text && topicMsgId) {
                                def gameDetail = "**🎮 Game 详细报告:**\n${gameResult.review.review_text}"
                                def maxLen = 3000
                                if (gameDetail.length() > maxLen) {
                                    gameDetail = gameDetail.substring(0, maxLen) + "\n\n... (剩余内容请在 Jenkins 构建日志中查看)"
                                }
                                def gameB64 = b64(gameDetail)
                                sh """
                                    ${PYTHON} ${SCRIPTS_DIR}/feishu_notifier.py reply-message \
                                        --app-id '${feishuAppId}' \
                                        --app-secret '${feishuAppSecret}' \
                                        --chat-id '${feishuChatId}' \
                                        --message-id '${topicMsgId}' \
                                        --message-base64 '${gameB64}'
                                """
                            }

                            env.FEISHU_TOPIC_MSG_ID = topicMsgId
                            }
                    } catch (Exception e) {
                        echo "Bot API notification failed, falling back to webhook: ${e}"
                        if (env.FEISHU_WEBHOOK_URL) {
                            def webhookB64 = b64(topicText)
                            sh """
                                ${PYTHON} ${SCRIPTS_DIR}/feishu_notifier.py webhook \
                                    --webhook-url '${env.FEISHU_WEBHOOK_URL}' \
                                    --message-base64 '${webhookB64}'
                            """
                        }
                    }
                } else if (env.FEISHU_WEBHOOK_URL) {
                    def webhookB64 = b64(topicText)
                    sh """
                        ${PYTHON} ${SCRIPTS_DIR}/feishu_notifier.py webhook \
                            --webhook-url '${env.FEISHU_WEBHOOK_URL}' \
                            --message-base64 '${webhookB64}'
                    """
                }

                // Mark as reviewed in state file
                def state = [:]
                if (fileExists(REVIEWED_STATE_FILE)) {
                    state = readJSON(file: REVIEWED_STATE_FILE)
                }
                def reviewed = state.reviewed ?: []
                if (!(env.ISSUE_KEY in reviewed)) {
                    reviewed.add(env.ISSUE_KEY)
                    // Keep last 200, trim oldest
                    if (reviewed.size() > 200) {
                        reviewed = reviewed[-200..-1]
                    }
                    writeJSON(file: REVIEWED_STATE_FILE, json: [reviewed: reviewed])
                    echo "Marked ${env.ISSUE_KEY} as reviewed"
                }

                // Manual mode: mark DONE after successful notification.
                def manTopic = params.JIRA_URL ?: 'manual-topic'
                psCmd("transition --key '${manTopic}' --to NOTIFYING --status RUNNING")
                psCmd("transition --key '${manTopic}' --to DONE --status SUCCESS")
                codereviewLog('DONE', 'SUCCESS', manTopic, env.ISSUE_KEY, env.PROJECT, '', 'manual review complete')
            }
        }

        failure {
            script {
                if (env.ISSUE_KEY != null && env.ISSUE_KEY != '') {
                    def topicMsgId = env.FEISHU_TOPIC_MSG_ID ?: ''
                    def feishuAppId = env.FEISHU_APP_ID ?: ''
                    def feishuAppSecret = env.FEISHU_APP_SECRET ?: ''

                    if (topicMsgId && feishuAppId && feishuAppSecret) {
                        def errText = "❌ **Code Review Failed**: ${env.ISSUE_KEY}\nBuild: ${BUILD_URL}"
                        def errB64 = b64(errText)
                        sh """
                            ${PYTHON} ${SCRIPTS_DIR}/feishu_notifier.py reply-message \
                                --app-id '${feishuAppId}' \
                                --app-secret '${feishuAppSecret}' \
                                --chat-id '${env.FEISHU_CHAT_ID}' \
                                --message-id '${topicMsgId}' \
                                --message-base64 '${errB64}'
                        """
                    } else if (env.FEISHU_WEBHOOK_URL) {
                        def msgText = "❌ Code Review Failed: ${env.ISSUE_KEY}\nBuild: ${BUILD_URL}"
                        def msgB64 = b64(msgText)
                        sh """
                            ${PYTHON} ${SCRIPTS_DIR}/feishu_notifier.py webhook \
                                --webhook-url '${env.FEISHU_WEBHOOK_URL}' \
                                --message-base64 '${msgB64}'
                        """
                    }

                    // Manual mode: mark FAILED (build failed).
                    def manTopic = params.JIRA_URL ?: 'manual-topic'
                    def hadTopic = fileExists(PIPELINE_STATE_FILE)
                    if (hadTopic) {
                        psCmd("transition --key '${manTopic}' --to FAILED --status FAILED --error 'build failed'")
                        codereviewLog('MANUAL', 'FAILED', manTopic, env.ISSUE_KEY, env.PROJECT, '', 'manual build failure')
                    }
                }
            }

        cleanup {
            sh "rm -rf ${SCAN_RESULT_FILE} ${PARSED_INFO_FILE} ${ENGINE_RESULT_FILE} ${GAME_RESULT_FILE} ${env.WORKSPACE}/engine_review.json ${env.WORKSPACE}/game_review.json ${env.WORKSPACE}/feishu_msg.json ${env.WORKSPACE}/feishu_err_msg.json ${env.WORKSPACE}/feishu_topic_msg.json ${env.WORKSPACE}/feishu_engine_reply.json ${env.WORKSPACE}/feishu_game_reply.json ${env.WORKSPACE}/feishu_err_reply.json ${env.WORKSPACE}/feishu_progress.json ${env.WORKSPACE}/feishu_summary_reply.json ${env.WORKSPACE}/.fs_*.txt ${env.WORKSPACE}/.feishu_reply_msg_id ${env.WORKSPACE}/.rendered_*.md ${env.WORKSPACE}/.eng_update_* ${env.WORKSPACE}/result_*.json ${env.WORKSPACE}/parsed_*.json ${env.WORKSPACE}/.reply_msg_id_* ${env.WORKSPACE}/.state_*.json || true"
        }
    }
}
}

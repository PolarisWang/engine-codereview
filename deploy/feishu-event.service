# ⚠️ DEPRECATED for the current agent-container deployment.
#
# This systemd unit targets a HOST path (/home/debian/agent/engine-codereview) and a
# host-persistent service. The bot is actually deployed INSIDE the Jenkins-agent
# container and supervised by deploy/run-event-server-watchdog.sh (see docs/
# deploy-architecture.md). This file is kept only as an alternative/legacy option
# (e.g. running on a dedicated host with systemd) — it is NOT installed here.
[Unit]
Description=Feishu Code Review Event Server (real-time interaction)
After=network.target

[Service]
Type=simple
User=debian
WorkingDirectory=/home/debian/agent/engine-codereview/jenkins/scripts
# ENV is injected by the same Jenkins-managed env vars (FEISHU_APP_ID etc.), or
# via an EnvironmentFile if you keep secrets there.
EnvironmentFile=/home/debian/agent/engine-codereview/.env
# ws mode = long-connection (no public callback URL needed). Requires lark_oapi.
ExecStart=/usr/bin/python3 /home/debian/agent/engine-codereview/jenkins/scripts/event_server.py --mode ws
Restart=always
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
